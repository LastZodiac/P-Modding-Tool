<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built by the build workspace (see ../build). Produces "P+ Modding Tool.exe" for Windows (.NET Framework 4.7.2, built into Windows 10/11). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>P+ Modding Tool</AssemblyName>
    <RootNamespace>SkinManager.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.1.1</Version>
    <Product>P+ Modding Tool</Product>
    <Company>Last Zodiac</Company>
    <Authors>Last Zodiac</Authors>
    <Copyright>Copyright (c) 2026 Last Zodiac. Licensed under the GNU GPL v3.0.</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Description>Mods, stats and frame data for Project+ on Brawl Online.</Description>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="Assets/logo96.png" LogicalName="logo96.png" />
    <Compile Include="../SkinManager.Core/*.cs" />
    <Compile Include="../SkinManager.Core/ThirdParty/NLayer/**/*.cs" />
    <Reference Include="BrawlLib"><HintPath>$(BrawlLibPath)</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
